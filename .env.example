# Copy to .env and fill in. Loaded via pydantic-settings (sra/core/config.py in Phase 3).

# --- LLM providers (at least one required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Which provider drives reasoning for a run: "openai" | "anthropic"
SRA_LLM_PROVIDER=openai
SRA_LLM_MODEL=gpt-4o

# --- Search providers ---
# Google Programmable Search (used by the Google Search tool)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# Comma-separated roots allowed for local_document_search
SRA_LOCAL_DOCUMENT_ROOTS=./data

# --- Storage paths ---
SRA_DATA_DIR=./data
SRA_CONTROL_DB=./data/control.sqlite3
SRA_KNOWLEDGE_DB=./data/knowledge.duckdb

# --- Budget defaults (overridable per run) ---
SRA_MAX_ITERATIONS=40
SRA_MAX_TOKENS=500000
SRA_MAX_COST_USD=5.0
SRA_MAX_MINUTES=30
SRA_MAX_SOURCES=60
SRA_CONFIDENCE_THRESHOLD=0.7

# Tool autonomy: safe | standard | unrestricted
# safe = local/compute only; standard = + network search/fetch; unrestricted = all tags
SRA_TOOL_AUTONOMY=standard
